# ─── Core ───────────────────────────────────────────────────
VINO_JP_CONFIG_PORT=10060
VINO_JP_CONFIG_ENV=dev
VINO_JP_TOKEN_SECRET=devSecretChangeMe
VINO_JP_SITE_URL=http://localhost:10060

# ─── MySQL ──────────────────────────────────────────────────
VINO_JP_CONFIG_DB_HOST=127.0.0.1
VINO_JP_CONFIG_DB_PORT=3306
VINO_JP_CONFIG_DB_USERNAME=root
VINO_JP_CONFIG_DB_PASSWORD=root
VINO_JP_CONFIG_DB_NAME=tvii
VINO_JP_CONFIG_WHITELIST_DB_NAME=whitelist

# ─── Discord webhook (optional in dev) ─────────────────────
VINO_JP_CONFIG_DC_WEBHOOK_URL=

# ─── Bluesky AES key – base64, 32 bytes (optional in dev) ──
VINO_JP_CONFIG_BSKY_AES_KEY=

# ─── MinIO / S3 (optional in dev) ──────────────────────────
VINO_JP_MINIO_PUBLIC_URL=
VINO_JP_MINIO_PORT=9000
VINO_JP_MINIO_ENDPOINT=localhost
VINO_JP_MINIO_ACCESS_KEY=
VINO_JP_MINIO_SECRET_KEY=
VINO_JP_MINIO_BUCKET=

# ─── TV listing provider URLs (US/CA, optional in dev) ─────
VINO_JP_TV_CDN_URL=
VINO_JP_TV_LISTINGS_URL=
VINO_JP_TV_LINEUPS_URL=
VINO_JP_TV_LINEUPS_SET_BASE_URL=
VINO_JP_TV_PROGRAM_DETAILS_BASE_URL=
VINO_JP_TV_SEASON_CAST_URL=

# ─── Staff PIDs (comma-separated) ──────────────────────────
VINO_JP_STAFF_PIDS=0

# ─── JP XMLTV EPG (set ENABLED=true to activate) ───────────
VINO_JP_XMLTV_ENABLED=false
VINO_JP_XMLTV_PATH=./data/epg_ripper_JP1.xml.gz,./data/epg_ripper_JP2.xml.gz
VINO_JP_XMLTV_LINEUP_PATH=./data/japan.json
VINO_JP_XMLTV_TZ=Asia/Tokyo
VINO_JP_XMLTV_REFRESH_MINUTES=30
VINO_JP_XMLTV_ADULT_FILTER=true

# ─── Docker Compose passwords (used by docker-compose.yml) ─
MYSQL_ROOT_PASSWORD=changeme
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
